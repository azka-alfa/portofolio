---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';

const year = new Date().getFullYear();
---

<Layout>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="#atas" aria-label={`${profile.name}, kembali ke atas`}>
        <span class="brand-mark" aria-hidden="true">{profile.initials}</span>
        <span class="brand-name">{profile.name}</span>
      </a>
      <button class="menu-btn" id="menuBtn" aria-expanded="false" aria-controls="siteNav">
        Menu
      </button>
      <nav class="site-nav" id="siteNav" aria-label="Navigasi utama">
        <a href="#tentang">Tentang</a>
        <a href="#layanan">Layanan</a>
        <a href="#proyek">Proyek</a>
        <a href="#keahlian">Keahlian</a>
        <a class="nav-cta" href="#kontak">Kontak</a>
      </nav>
    </div>
  </header>

  <main id="atas">
    <!-- Hero -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <p class="hero-kicker">Halo, saya {profile.name}. {profile.role} dari {profile.location}.</p>
          <h1>{profile.tagline}</h1>
          <p class="hero-intro">{profile.intro}</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#proyek">Lihat proyek</a>
            <a class="btn btn-ghost" href={profile.socials.github} target="_blank" rel="noopener">GitHub saya</a>
          </div>
          <p class="hero-status">{profile.availability}.</p>
        </div>
        <div class="hero-card" aria-hidden="true">
          <span class="hero-initials">{profile.initials}</span>
          <span class="hero-card-name">{profile.name}</span>
          <span class="hero-card-role">{profile.role}</span>
        </div>
      </div>
    </section>

    <!-- Tentang -->
    <section id="tentang" class="alt">
      <div class="wrap">
        <div class="section-head">
          <h2>Tentang saya</h2>
        </div>
        <div class="about-grid">
          {profile.about.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <!-- Layanan -->
    <section id="layanan">
      <div class="wrap">
        <div class="section-head">
          <h2>Yang bisa saya kerjakan</h2>
          <p>Fokus utama saya saat ini. Di luar daftar ini, silakan tanyakan dulu lewat halaman kontak.</p>
        </div>
        <ol class="service-list">
          {
            profile.services.map((service, i) => (
              <li class="service-row">
                <span class="service-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Proyek -->
    <section id="proyek" class="alt">
      <div class="wrap">
        <div class="section-head">
          <h2>Proyek</h2>
          <p>Daftar ini akan bertambah. Status tiap proyek ditulis apa adanya: live, konsep, atau eksperimen.</p>
        </div>
        <div class="project-list">
          {
            profile.projects.map((project, i) => (
              <article class="project-row">
                <div class="project-main">
                  <p class="project-meta">
                    <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                    <span>{project.year}</span>
                    <span class="project-status">{project.status}</span>
                  </p>
                  <h3>{project.title}</h3>
                  <p class="project-desc">{project.description}</p>
                  <a href={project.url} target="_blank" rel="noopener">{project.urlLabel}</a>
                </div>
                <ul class="stack-list" aria-label="Teknologi yang dipakai">
                  {project.stack.map((tech) => <li>{tech}</li>)}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Keahlian -->
    <section id="keahlian">
      <div class="wrap">
        <div class="section-head">
          <h2>Keahlian</h2>
          <p>Alat dan teknologi yang saya pakai sehari-hari.</p>
        </div>
        <ul class="skill-list">
          {profile.skills.map((skill) => <li>{skill}</li>)}
        </ul>
      </div>
    </section>

    <!-- Kontak -->
    <section id="kontak" class="contact">
      <div class="wrap">
        <h2>Punya proyek, atau sekadar ingin menyapa?</h2>
        <p>
          Cara tercepat menghubungi saya saat ini lewat GitHub. Tulis kebutuhanmu secara singkat,
          saya balas begitu sempat.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={profile.socials.github} target="_blank" rel="noopener">Buka GitHub Azka Alfa</a>
          {profile.socials.email && (
            <a class="btn btn-ghost" href={`mailto:${profile.socials.email}`}>Kirim email</a>
          )}
          {profile.socials.linkedin && (
            <a class="btn btn-ghost" href={profile.socials.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          )}
          {profile.socials.instagram && (
            <a class="btn btn-ghost" href={profile.socials.instagram} target="_blank" rel="noopener">Instagram</a>
          )}
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <p>© {year} {profile.name}. Dibangun dengan Astro, di-deploy di Cloudflare Pages.</p>
      <a href="#atas">Kembali ke atas</a>
    </div>
  </footer>

  <script>
    const btn = document.getElementById('menuBtn');
    const nav = document.getElementById('siteNav');
    btn?.addEventListener('click', () => {
      const open = nav?.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(Boolean(open)));
    });
    nav?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        nav.classList.remove('open');
        btn?.setAttribute('aria-expanded', 'false');
      });
    });
  </script>
</Layout>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 68px;
  }
  .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; color: var(--ink); }
  .brand-mark {
    display: inline-grid; place-items: center;
    width: 40px; height: 40px; border-radius: 8px;
    background: var(--ink); color: var(--paper);
    font-family: "Fraunces", Georgia, serif; font-weight: 700; font-size: 0.95rem;
  }
  .brand-name { font-weight: 700; }
  .site-nav { display: flex; align-items: center; gap: 28px; }
  .site-nav a { color: var(--ink); text-decoration: none; font-weight: 500; padding: 10px 2px; }
  .site-nav a:hover { color: var(--accent-ink); text-decoration: underline; text-underline-offset: 4px; }
  .site-nav .nav-cta { color: var(--accent-ink); font-weight: 700; }
  .menu-btn {
    display: none;
    min-height: 44px; min-width: 44px;
    padding: 10px 16px;
    background: transparent; color: var(--ink);
    border: 1px solid var(--ink); border-radius: 8px;
    font: inherit; font-weight: 600; cursor: pointer;
  }

  .hero { padding: 84px 0 76px; }
  .hero-grid { display: grid; grid-template-columns: 1.7fr 1fr; gap: 56px; align-items: center; }
  .hero-kicker { font-weight: 600; color: var(--accent-ink); margin: 0 0 18px; }
  .hero h1 { font-size: clamp(2.4rem, 5.4vw, 3.9rem); margin-bottom: 22px; }
  .hero-intro { color: var(--ink-soft); max-width: 560px; margin: 0 0 30px; font-size: 1.06rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 48px; padding: 12px 22px;
    border-radius: 8px; font-weight: 700; text-decoration: none;
    border: 1px solid var(--ink);
  }
  .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .btn-primary:hover { background: var(--accent-ink); border-color: var(--accent-ink); }
  .btn-ghost { background: transparent; color: var(--ink); }
  .btn-ghost:hover { background: var(--paper-deep); }
  .hero-status { margin: 22px 0 0; color: var(--ink-soft); font-size: 0.95rem; }
  .hero-card {
    background: var(--ink); color: var(--paper);
    border-radius: var(--radius);
    padding: 36px 30px;
    display: flex; flex-direction: column; gap: 6px;
    aspect-ratio: 4 / 5; justify-content: flex-end;
  }
  .hero-initials { font-family: "Fraunces", Georgia, serif; font-size: 4.6rem; font-weight: 700; line-height: 1; }
  .hero-card-name { font-weight: 700; font-size: 1.15rem; margin-top: 14px; }
  .hero-card-role { color: #d6cec0; }

  .alt { background: var(--paper-deep); }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; max-width: 920px; }
  .about-grid p { margin: 0; color: var(--ink-soft); }

  .service-list { list-style: none; margin: 0; padding: 0; }
  .service-row {
    display: grid; grid-template-columns: 56px 1fr 1.4fr; gap: 20px; align-items: baseline;
    padding: 26px 0; border-top: 1px solid var(--line);
  }
  .service-row:last-child { border-bottom: 1px solid var(--line); }
  .service-num { font-family: "Fraunces", Georgia, serif; font-weight: 700; color: var(--accent-ink); }
  .service-row h3 { font-size: 1.3rem; }
  .service-row p { margin: 0; color: var(--ink-soft); }

  .project-list { display: flex; flex-direction: column; gap: 20px; }
  .project-row {
    background: var(--paper);
    border: 1px solid var(--line); border-radius: var(--radius);
    padding: 30px;
    display: grid; grid-template-columns: 1.8fr 1fr; gap: 28px;
  }
  .project-meta { display: flex; gap: 16px; margin: 0 0 12px; font-size: 0.9rem; font-weight: 600; color: var(--ink-soft); }
  .project-status { color: var(--accent-ink); text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.8rem; }
  .project-row h3 { font-size: 1.55rem; margin-bottom: 10px; }
  .project-desc { color: var(--ink-soft); margin: 0 0 16px; }
  .project-row a { font-weight: 700; }
  .stack-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; align-content: start; }
  .stack-list li { border-bottom: 1px dashed var(--line); padding-bottom: 8px; font-weight: 500; }

  .skill-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; max-width: 820px; }
  .skill-list li {
    border: 1px solid var(--ink); border-radius: 8px;
    padding: 9px 16px; font-weight: 600; min-height: 44px;
    display: inline-flex; align-items: center;
  }

  .contact h2 { font-size: clamp(2rem, 4.6vw, 3rem); max-width: 640px; margin-bottom: 14px; }
  .contact p { color: var(--ink-soft); max-width: 560px; margin: 0 0 28px; }

  .site-footer { border-top: 1px solid var(--line); padding: 28px 0; }
  .footer-inner { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .footer-inner p { margin: 0; color: var(--ink-soft); }

  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-card { aspect-ratio: auto; }
    .about-grid { grid-template-columns: 1fr; }
    .service-row { grid-template-columns: 40px 1fr; }
    .service-row p { grid-column: 2; }
    .project-row { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .menu-btn { display: inline-flex; align-items: center; justify-content: center; }
    .site-nav {
      display: none;
      position: absolute; top: 68px; left: 0; right: 0;
      flex-direction: column; align-items: stretch; gap: 0;
      background: var(--paper); border-bottom: 1px solid var(--line);
      padding: 8px 24px 16px;
    }
    .site-nav.open { display: flex; }
    .site-nav a { padding: 12px 2px; border-top: 1px solid var(--line); }
    .hero { padding: 56px 0; }
  }
</style>
